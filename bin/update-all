#!/usr/bin/env bash
# update-all: bring everything on this machine up to date.
#
#   update-all          system (dnf, flatpak, Ollama; asks for sudo) and then the user part
#   update-all --user   only the user part: what the weekly user timer runs
#
# The system part also runs on its own every week as root (weekly-update.timer),
# so day to day you never need to call this by hand.
# Logs of the automatic runs: journalctl --user -u update-all
#                             journalctl -u weekly-update

set -uo pipefail

DOTFILES="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
USER_ONLY=0
case "${1:-}" in
    --user) USER_ONLY=1 ;;
    "") ;;
    -h|--help) sed -n '2,11p' "$0"; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
esac

failed=()
step() { # name command...
    local name=$1; shift
    printf '\n\033[1;35m==>\033[0m %s\n' "$name"
    "$@" || { printf '  \033[31m✗ %s failed\033[0m\n' "$name" >&2; failed+=("$name"); }
}
has() { command -v "$1" >/dev/null; }

# ── System (only when run by hand; the root timer covers it otherwise) ──
if [ $USER_ONLY = 0 ]; then
    step "dnf"           sudo dnf upgrade --refresh -y
    has flatpak && step "flatpak (system)" sudo flatpak update -y --noninteractive
    [ -x /usr/local/sbin/update-ollama ] && step "ollama" sudo /usr/local/sbin/update-ollama
fi

# ── User ────────────────────────────────────────────────────────────────
has flatpak && step "flatpak (user)" flatpak update --user -y --noninteractive
has uv && step "uv: Python versions" uv python upgrade
has uv && step "uv: tools"           uv tool upgrade --all
# Global npm CLIs, only when they live in $HOME (npm prefix ~/.local), never with sudo.
if has npm && [[ "$(npm config get prefix 2>/dev/null)" == "$HOME"* ]]; then
    step "npm: global tools" npm update -g
fi
step "superterm: binaries, links, plugins" "$DOTFILES/install.sh" --no-packages --update
tpm="$HOME/.config/tmux/plugins/tpm/bin/update_plugins"
[ -x "$tpm" ] && step "tmux plugins" "$tpm" all
has ya && step "yazi plugins" ya pkg upgrade

# ── Summary ─────────────────────────────────────────────────────────────
notify() { has notify-send && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && notify-send -a update-all "$@"; }

# The root timer cannot notify the desktop, so report its failures from here.
if systemctl is-failed -q weekly-update.service 2>/dev/null; then
    failed+=("system update (journalctl -u weekly-update)")
fi

# Orphaned packages: installed, but no enabled repo offers them any more, so dnf upgrade
# silently stops updating them (and they can block a Fedora release upgrade). This is what
# happened when Fedora renamed nodejs to nodejs22 without an Obsoletes. Locally built kmods
# (akmods) are orphans by design. The successor is the repo package that provides the old
# name; replacing is offered only by hand, never done unattended.
check_orphans() {
    has dnf || return 0
    local orphans p s old=() new=() none=()
    mapfile -t orphans < <(dnf repoquery --extras -q --qf '%{name}\n' 2>/dev/null \
        | grep -vE '^(kmod-|gpg-pubkey$)' | sort -u)
    [ ${#orphans[@]} -eq 0 ] && return 0

    printf '\n\033[1;33m==>\033[0m Packages no repository offers any more (not being updated)\n'
    for p in "${orphans[@]}"; do
        mapfile -t s < <(dnf repoquery -q --latest-limit=1 --whatprovides "$p" --qf '%{name}\n' \
            2>/dev/null | grep -vxF "$p" | sort -u)
        if [ ${#s[@]} -eq 1 ]; then
            echo "  $p -> ${s[0]}"; old+=("$p"); new+=("${s[0]}")
        else
            echo "  $p -> ${s[*]:-no replacement found}"; none+=("$p")
        fi
    done
    local cmd=""
    [ ${#old[@]} -gt 0 ] && cmd="sudo dnf do --action=remove ${old[*]} --action=install ${new[*]}"
    [ -n "$cmd" ] && echo "  Replace with: $cmd"
    [ ${#none[@]} -gt 0 ] && echo "  Check by hand: ${none[*]} (dnf remove if no longer needed)"

    if [ $USER_ONLY = 0 ] && [ -n "$cmd" ] && [ -t 0 ]; then
        # dnf shows the full transaction and asks again before changing anything.
        read -rp "  Replace them now? [y/N] " a
        if [[ $a =~ ^[yY]$ ]]; then
            sudo dnf do --action=remove "${old[@]}" --action=install "${new[@]}" && return 0
        fi
    fi
    notify -u critical -i dialog-warning "Packages no longer updated: ${orphans[*]}" \
        "Run update-all in a terminal to replace them (log: journalctl --user -u update-all)"
}
check_orphans

if ! dnf -q needs-restarting >/dev/null 2>&1; then
    echo; echo "Reboot needed: core libraries or the kernel were updated."
    notify -i system-reboot "Reboot recommended" "The system was updated; restart when convenient."
fi

echo
if [ ${#failed[@]} -eq 0 ]; then
    echo "All up to date."
else
    echo "Failed: ${failed[*]}" >&2
    notify -u critical -i dialog-warning "update-all: something failed" \
        "${failed[*]} — see: journalctl --user -u update-all"
    exit 1
fi
