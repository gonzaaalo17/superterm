#!/usr/bin/env bash
# dev: one tmux session per project, with Neovim, opencode and a shell side by side.
#
#   dev [dir]      open the project's workspace, or go back to it if it is already open
#   dev -k [dir]   close it (no dir inside a workspace: the current one)
#
# A project is the directory given, or the current one; inside a git repo, the repo's root.
# In ~ it offers the folders of ~/Projects to pick from; / is refused. The session is named
# after the folder and has one window, "code", with three panes:
#
#   ┌──────────────┬──────────┐
#   │ nvim         │ opencode │   opencode resumes the project's last conversation
#   ├──────────────┤          │
#   │ shell        │          │
#   └──────────────┴──────────┘
#
# Leaving it (closing Ghostty, prefix d) keeps everything running; `dev` there brings it back.
# Closing it (dev -k, tmux kill-server, a reboot) is for good: sessions are not saved or restored.
# `dev` then starts it again; opencode resumes the conversation, Space qs in nvim reopens files.
#
# Used by tmux and nvim, not meant to be typed:
#   dev --zoom SESSION   the agent full screen / back to the layout (prefix a)
#   dev --send TEXT      type TEXT into the agent's prompt and go to it (nvim: Space ao)
#   dev --start SESSION  start nvim and opencode in a new workspace, once a terminal shows it
set -euo pipefail

AGENT_WIDTH=40%   # of the window
SHELL_HEIGHT=25%  # of the nvim column
SELF=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")
die() { echo "dev: $*" >&2; exit 1; }

project_root() { # [dir] -> absolute project root
    local dir=${1:-$PWD}
    [ -d "$dir" ] || die "no such directory: $dir"
    dir=$(cd "$dir" && pwd -P)
    git -C "$dir" rev-parse --show-toplevel 2>/dev/null || echo "$dir"
}

pick_project() { # -> a folder of ~/Projects, or exit
    [ -d "$HOME/Projects" ] || die "in ~, give a directory: dev <dir> (no ~/Projects to pick from)"
    command -v fzf >/dev/null || die "in ~, give a directory: dev <dir> (fzf is needed to pick one)"
    local p
    p=$(find "$HOME/Projects" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%f\n' | sort \
        | fzf --reverse --height=40% --header='Project (~/Projects)') || exit 0
    echo "$HOME/Projects/$p"
}

session_root() { # session -> the project root dev opened it on, or nothing if dev didn't
    tmux show-options -qv -t "=$1:" @dev_root 2>/dev/null || true
}

is_workspace() { # session -> true if dev made it
    [ -n "$(session_root "$1")" ]
}

session_for() { # root -> session name: the folder's, or parent-folder if that one is taken
    local root=$1 name
    local base n=2
    name=$(basename "$root" | tr -c '[:alnum:]_\n-' '_')   # no . : (tmux targets), spaces, quotes
    taken() { tmux has-session -t "=$1" 2>/dev/null && [ "$(session_root "$1")" != "$root" ]; }
    if taken "$name"; then
        name="$(basename "$(dirname "$root")" | tr -c '[:alnum:]_\n-' '_')-$name"
        base=$name
        while taken "$name"; do name="$base-$n"; n=$((n + 1)); done
    fi
    echo "$name"
}

go() { # session [new]: switch to it from inside tmux, attach to it from outside. A new one gets
    # its programs started once a terminal shows it: started before, nvim's queries to the terminal
    # (DECRQM, DA1) go out through tmux and their answers come back typed into nvim as keys.
    local s=$1 new=${2:-}
    if [ -n "${TMUX:-}" ]; then
        tmux switch-client -t "=$s"
        [ -z "$new" ] || start "$s"
    else
        [ -z "$new" ] || tmux set-hook -t "=$s:" client-attached \
            "set-hook -u -t '=$s:' client-attached ; run-shell -b \"'$SELF' --start '$s'\""
        exec tmux attach-session -t "=$s"
    fi
}

opencode_cmd() { # root -> how to start opencode there: --continue only if there is a conversation
    # (opencode 1.19 shows "Unexpected server error" on --continue in a project without one)
    if (cd "$1" && timeout 5 opencode session list -n 1 --format json </dev/null 2>/dev/null) | grep -q '"id"'; then
        echo 'opencode --continue'
    else
        echo 'opencode'
    fi
}

find_role() { # session role -> the id of the pane dev tagged with that role, or nothing
    tmux list-panes -s -t "=$1" -F '#{pane_id} #{@dev_role}' 2>/dev/null \
        | awk -v r="$2" '$2 == r { print $1; exit }'
}

find_agent() { find_role "$1" agent; }   # session -> the agent's pane id, or nothing

no_passthrough() { # pane: opencode sends its terminal queries through tmux's passthrough
    # (allow-passthrough is on for yazi's images); the answers came back typed into whatever
    # pane was active, nvim's dashboard included. Without it in opencode's pane tmux answers them.
    tmux set-option -p -t "$1" allow-passthrough off
}

agent_pane() { # session -> the agent's pane id, opening it on the right if missing
    local s=$1 pane root target
    pane=$(find_agent "$s")
    if [ -z "$pane" ]; then
        root=$(session_root "$s")   # outside a workspace: where you are
        [ -n "$root" ] || root=$(tmux display-message -p -t "=$s:" '#{pane_current_path}')
        target="=$s:code"
        tmux list-windows -t "=$s" -F '#W' | grep -qx code || target="=$s:"
        pane=$(tmux split-window -d -h -f -l "$AGENT_WIDTH" -t "$target" -c "$root" -P -F '#{pane_id}')
        no_passthrough "$pane"
        tmux send-keys -t "$pane" "$(opencode_cmd "$root")" Enter   # the session is on screen
    fi
    tmux set-option -p -t "$pane" @dev_role agent
    echo "$pane"
}

show_pane() { # pane: make it the current pane of its session
    tmux select-window -t "$1"
    tmux select-pane -t "$1"
}

create() { # root name
    local root=$1 name=$2 size=() w="" h="" code agent
    # Detached sessions are 80x24: start at the terminal's size so the split percentages hold.
    if [ -n "${TMUX:-}" ]; then
        w=$(tmux display-message -p '#{client_width}'); h=$(tmux display-message -p '#{client_height}')
    fi
    if [ -z "$w" ] && [ -t 1 ]; then w=$(tput cols); h=$(tput lines); fi
    [ -n "$w" ] && [ -n "$h" ] && size=(-x "$w" -y "$h")
    code=$(tmux new-session -d -P -F '#{pane_id}' -s "$name" -c "$root" -n code "${size[@]}")
    tmux set-option -t "=$name:" @dev_root "$root"
    tmux set-option -p -t "$code" @dev_role code
    agent=$(tmux split-window -d -h -f -l "$AGENT_WIDTH" -t "$code" -c "$root" -P -F '#{pane_id}')
    tmux set-option -p -t "$agent" @dev_role agent
    no_passthrough "$agent"
    tmux split-window -d -v -l "$SHELL_HEIGHT" -t "$code" -c "$root"
    tmux select-pane -t "$code"
}

start() { # session: start nvim and opencode in a new workspace (see go). Typed into the panes'
    # shells, not run as their commands: quitting nvim or opencode leaves a shell, not a gap.
    local s=$1 code agent
    code=$(find_role "$s" code); agent=$(find_role "$s" agent)
    [ -z "$code" ] || tmux send-keys -t "$code" 'nvim' Enter
    [ -z "$agent" ] || tmux send-keys -t "$agent" "$(opencode_cmd "$(session_root "$s")")" Enter
}

zoom() { # session the key was pressed in: the agent full screen, or back to the layout
    local s=$1 pane cur zoomed
    pane=$(agent_pane "$s")
    cur=$(tmux display-message -p -t "=$s:" '#{pane_id}')
    zoomed=$(tmux display-message -p -t "$pane" '#{window_zoomed_flag}')
    if [ "$cur" = "$pane" ] && [ "$zoomed" = 1 ]; then
        tmux resize-pane -Z -t "$pane"
        tmux last-pane -t "$pane" 2>/dev/null || true   # back where you were
    else
        show_pane "$pane"
        [ "$zoomed" = 1 ] || tmux resize-pane -Z -t "$pane"
    fi
}

send() { # text
    [ -n "${TMUX:-}" ] || die "--send only works inside tmux"
    local s pane
    s=$(tmux display-message -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#{session_name}')
    if [ -z "$(find_agent "$s")" ]; then
        pane=$(agent_pane "$s")
        for _ in $(seq 1 50); do   # wait for opencode to draw its prompt
            [ "$(tmux display-message -p -t "$pane" '#{pane_current_command}')" = opencode ] && break
            sleep 0.2
        done
        sleep 2
    else
        pane=$(agent_pane "$s")
    fi
    tmux send-keys -t "$pane" -l "$1"
    show_pane "$pane"
}

case "${1:-}" in
    -h|--help) sed -n '2,24p' "$0"; exit 0 ;;
    --zoom) zoom "${2:?usage: dev --zoom SESSION}"; exit 0 ;;
    --send) send "${2:?usage: dev --send TEXT}"; exit 0 ;;
    --start) start "${2:?usage: dev --start SESSION}"; exit 0 ;;
    -k)
        if [ -z "${2:-}" ] && [ -n "${TMUX:-}" ]; then
            name=$(tmux display-message -p '#{session_name}')
            is_workspace "$name" || die "this session is not a dev workspace; give its directory"
        else
            root=$(project_root "${2:-}")
            name=$(session_for "$root")
            tmux has-session -t "=$name" 2>/dev/null && [ "$(session_root "$name")" = "$root" ] \
                || die "no workspace open for $root"
        fi
        tmux kill-session -t "=$name"
        exit 0 ;;
    -*) die "unknown option: $1 (see dev --help)" ;;
esac

dir=${1:-$PWD}
if [ -z "${1:-}" ] && [ "$(cd "$dir" && pwd -P)" = "$(cd "$HOME" && pwd -P)" ]; then
    dir=$(pick_project)
fi
root=$(project_root "$dir")
[ "$root" != / ] || die "/ is not a project"
[ "$root" != "$(cd "$HOME" && pwd -P)" ] || die "~ is not a project: run dev in a project's folder"
name=$(session_for "$root")
if tmux has-session -t "=$name" 2>/dev/null; then
    go "$name"
else
    create "$root" "$name"
    go "$name" new
fi
