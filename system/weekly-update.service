# Installed to /etc/systemd/system/ by install.sh (copied, not linked: it runs as root).
[Unit]
Description=Weekly system update (dnf, system flatpaks, Ollama)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/dnf upgrade --refresh -y
ExecStart=/usr/bin/flatpak update -y --noninteractive
# Skips itself when Ollama is not installed or already current.
ExecStart=/usr/local/sbin/update-ollama
Nice=10
IOSchedulingClass=idle
