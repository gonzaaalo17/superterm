# Included from ~/.gitconfig by install.sh ([include] path = …).
# Falls back to less/cat when delta is not installed, so git never breaks.
[core]
	pager = command -v delta >/dev/null 2>&1 && exec delta || exec less -FRX
[interactive]
	diffFilter = command -v delta >/dev/null 2>&1 && exec delta --color-only || exec cat
[delta]
	navigate = true
	line-numbers = true
	side-by-side = true
	hyperlinks = true
[merge]
	conflictStyle = zdiff3
[diff]
	colorMoved = default
