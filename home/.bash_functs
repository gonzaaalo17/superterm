# ~/.bash_functs — all custom functions in one place
# Sourced from ~/.bashrc

# ═════════════════════════════════════════════════════════════════════════
# Files
# ═════════════════════════════════════════════════════════════════════════

# Move all files froma origin to a destiny
mvall () {
	origin="$1"
	destiny="$2"
	
	if [ ! -e "$destiny" ]; then
		mkdir -p "$destiny"
	fi

	if [ ! -d "$origin" ] || [ ! -d "$destiny" ]; then
		echo "Provide directories"
		return 1
	fi

	for file in "$origin"/*; do
		# if destiny is inside origin, skip from moving
		[ "$file" = "$destiny" ] && continue 

		mv "$file" "$destiny/$(basename "$file")"
	done

	return 0
}

# Copy all files froma origin to a destiny
cpall () {
	origin="$1"
	destiny="$2"
	
	if [ ! -e "$destiny" ]; then
		mkdir -p "$destiny"
	fi

	if [ ! -d "$origin" ] || [ ! -d "$destiny" ]; then
		echo "Provide directories"
		return 1
	fi

	for file in "$origin"/*; do
		# if destiny is inside origin, skip from moving
		[ "$file" = "$destiny" ] && continue 

		cp "$file" "$destiny/$(basename "$file")"
	done

	return 0
}

# Remove selected group
rmgroup() {

	local target="$1"
	local mode="$2"
	local help=$(cat <<-EOF
		This script will allow remove files and dirs inside a target upon selection
		Aim: Simulate the GUI functionalities with Ctrl+Click and SHIFT+Click
		CTRL + Click = --select
		SHIFT + Click = --range
		 
		Procedure:
		1. Build sorted list
		   - Same ordering convention as:
		   - LC_ALL=C ls -lah --group-directories-first
		   - We intentionally exclude "." and "..", but keep hidden files.
		2. Take user's selection by indexes from this sorted list.
		3. Remove them: If file normal rm, if dir rm -r

		Usage:
		  rmgroup TARGET --range FROM TO
		  rmgroup TARGET --select INDEX [INDEX ...]

		Examples:
		  rmgroup ./test --range 2 5
		  rmgroup ./test --select 1 3 7 9
		EOF
	)
	
	# If user types --help as first arg, display help
	if [ "$1" == "--help" ]; then
		echo "$help"
		return 0
	fi

	# If target and flag are empty, return error message
	if [[ -z "$target" || -z "$mode" ]]; then
		echo "Usage:"
		echo "  remove_some TARGET --range FROM TO"
		echo "  remove_some TARGET --select INDEX [INDEX ...]"
		return 2
	fi

	# If target is not a dir return error message
	if [[ ! -d "$target" ]]; then
		echo "Error: target is not a directory: $target"
		return 1
	fi
	
	# If mode is not the available ones, return error message. TODO Add --help
	if [[ "$mode" != "--range" && "$mode" != "--select" ]]; then
		echo "Error: unknown selection mode: $mode"
		echo "Expected --range or --select"
		return 2
	fi

	# Build sorted list of current dir
	local -a entries=()

	while IFS= read -r -d '' entry; do
		entries+=("$entry")
	done < <(
		find "$target" -mindepth 1 -maxdepth 1 -type d -printf '%f\0' | LC_ALL=C sort -z
		find "$target" -mindepth 1 -maxdepth 1 ! -type d -printf '%f\0' | LC_ALL=C sort -z
	)

	# If target directory is empty, return error message
	if (( ${#entries[@]} == 0 )); then
		echo "Target directory is empty: $target"
		return 0
	fi
	
	# This block gathers the exact entries selected by user and validates them
	local -a selected_indices=()

	if [[ "$mode" == "--range" ]]; then
		
		# If user gives more arguments than expected
		if [[ $# -ne 4 ]]; then
			echo "Error: --range requires exactly two indices."
			echo "Usage: remove_some TARGET --range FROM TO"
		    	return 2
		fi

		local from="$3"
		local to="$4"
		
		# If indexes are negative
		if [[ ! "$from" =~ ^[0-9]+$ || ! "$to" =~ ^[0-9]+$ ]]; then
		    	echo "Error: indices must be non-negative integers."
		    	return 2
		fi
		
		# If indexes are out of range
		if (( from >= ${#entries[@]} || to >= ${#entries[@]} )); then
		    	echo "Error: index out of range."
		   	echo "Valid range: 0-$(( ${#entries[@]} - 1 ))"
		    	return 1
		fi
		
		# If first index is greater than second
		if (( from > to )); then
		    	echo "Error: FROM must not be greater than TO."
		    	return 2
		fi
		
		# Gathers user's choices in an array
		for (( i = from; i <= to; i++ )); do
		    	selected_indices+=("$i")
		done

	else # --select
		# If argument count is less than 3 means user gave no selection
		if (( $# < 3 )); then
		    	echo "Error: --select requires at least one index."
		    	echo "Usage: remove_some TARGET --select INDEX [INDEX ...]"
		    	return 2
		fi
		
		# Gathers user's choices in an array
		for index in "${@:3}"; do
			# Index is negative
		    	if [[ ! "$index" =~ ^[0-9]+$ ]]; then
		        	echo "Error: invalid index: $index"
		        	echo "Indices must be non-negative integers."
		        	return 2
		    	fi
			
			# Index is out of range
		    	if (( index >= ${#entries[@]} )); then
		        	echo "Error: index out of range: $index"
		        	echo "Valid range: 0-$(( ${#entries[@]} - 1 ))"
		        	return 1
		    	fi
			
			# Avoid duplicated indexes
			if [[ " ${selected_indices[*]} " =~ " $index " ]]; then
				continue
			fi
			
		    	selected_indices+=("$index")
		done
	fi
	
	# Build selection associated ith indexes
	local -a selected_entries=()
	
	for selected_index in "${selected_indices[@]}"; do
		selected_entries+=("${entries[$selected_index]}")
	done

	# Print selection
	echo "Selection:"
	for i in "${!selected_indices[@]}"; do
		printf "  [%s] %s\n" \
	    	"${selected_indices[$i]}" \
	    	"${selected_entries[$i]}"
	done
	
	# User's confirmation
	echo
	read -r -p "Continue? [y/N] " answer
	
	# If user says no exit without error code
	if [[ ! "$answer" =~ ^[Yy]$ ]]; then
		echo "Cancelled."
		return 0
	fi

	# Delete selection
	local removed_count=0
	local failed_count=0
	local entry_path # Initiated below

	for i in "${!selected_entries[@]}"; do
		entry_path="$target/${selected_entries[$i]}"
		
		# If is file apply normal rm, if it is dir, apply recursive rm
		if [[ -d "$entry_path" ]]; then
			# Check if removing was successful
			if rm -r -- "$entry_path"; then
		            ((removed_count++))
		        else
		            ((failed_count++))
		        fi
		else
			# Check if removing was successful
		        if rm -- "$entry_path"; then
		            ((removed_count++))
		        else
		            ((failed_count++))
		        fi
		fi
	done

	echo
	echo "Removed: $removed_count"
	echo "Failed: $failed_count"

	if (( failed_count > 0 )); then
	    return 1
	fi

	return 0
}


# ll: long listing with eza icons and git status, in exactly the order rmgroup
# uses (directories first, then the rest, each LC_ALL=C sorted, hidden included,
# no . or ..), so the Nth row of `ll` is index N-1 for rmgroup.
# Extra flags fall back to plain eza: `ll -T`, `ll --sort=size`, …
function ll {
	if (( $# > 1 )) || [[ $# -eq 1 && ! -d "$1" ]]; then
		eza -la --icons --git --group-directories-first "$@"
		return
	fi
	local dir="${1:-.}"
	local -a entries=()
	while IFS= read -r -d '' entry; do
		entries+=("$entry")
	done < <(
		find "$dir" -mindepth 1 -maxdepth 1 -type d -printf '%f\0' | LC_ALL=C sort -z
		find "$dir" -mindepth 1 -maxdepth 1 ! -type d -printf '%f\0' | LC_ALL=C sort -z
	)
	(( ${#entries[@]} )) || return 0
	( builtin cd -- "$dir" && eza -ld --sort=none --icons --git --header -- "${entries[@]}" )
}

# cat: on screen, Markdown files are rendered with glow and everything else is
# shown with bat. When piped or redirected (`cat a.md | grep x`, `cat a > b`)
# it is plain cat, so scripts and pipes get the raw text.
function cat {
	if [[ -t 1 ]]; then
		local f all_md=1
		for f in "$@"; do
			[[ -f "$f" && "$f" =~ \.(md|markdown|MD)$ ]] || { all_md=0; break; }
		done
		if (( $# > 0 && all_md )) && command -v glow >/dev/null; then
			local style=dark
			[[ ${CATPPUCCIN_FLAVOR-} == latte ]] && style=light
			for f in "$@"; do glow -s "$style" -- "$f"; done
			return
		fi
		if command -v bat >/dev/null; then
			bat --paging=never "$@"
			return
		fi
	fi
	command cat "$@"
}

# ═════════════════════════════════════════════════════════════════════════
# Navigation and search (fzf / yazi)
# ═════════════════════════════════════════════════════════════════════════

# y: open yazi and, on quit, leave the shell in the directory you were browsing
y() {
	local tmp cwd
	tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd" || return
	fi
	rm -f -- "$tmp"
}

# fe: find a file with fzf (with preview) and open it in the editor
fe() {
	local file
	file="$(fzf --query="$1" --select-1 --exit-0 \
		--preview 'bat --color=always --style=numbers --line-range=:300 {}')" || return
	[ -n "$file" ] && "${EDITOR:-nvim}" "$file"
}

# rgf: search text with ripgrep, pick a match with fzf and open it at that line
rgf() {
	[ -z "$1" ] && { echo "Usage: rgf PATTERN"; return 2; }
	local sel
	sel="$(rg --line-number --no-heading --color=always --smart-case "$@" |
		fzf --ansi --delimiter : \
			--preview 'bat --color=always --highlight-line {2} {1}' \
			--preview-window '+{2}/2')" || return
	"${EDITOR:-nvim}" "+$(cut -d: -f2 <<< "$sel")" "$(cut -d: -f1 <<< "$sel")"
}

# ═════════════════════════════════════════════════════════════════════════
# System
# ═════════════════════════════════════════════════════════════════════════

# fkill: pick processes with fzf (Tab for several) and kill them. fkill 9 = SIGKILL
fkill() {
	local pids
	pids="$(ps -u "$USER" -o pid=,%cpu=,%mem=,cmd= --sort=-%cpu |
		fzf -m --header='Tab: mark · Enter: kill' | awk '{print $1}')" || return
	[ -n "$pids" ] && echo "$pids" | xargs kill -"${1:-15}" && echo "Killed: $(echo $pids)"
}

# mkcd: create a directory and cd into it
mkcd() {
	mkdir -p -- "$1" && cd -- "$1"
}

# extract: unpack any common archive format
extract() {
	[ -f "$1" ] || { echo "Usage: extract FILE"; return 2; }
	case "$1" in
		*.tar.gz|*.tgz)   tar xzf "$1" ;;
		*.tar.bz2|*.tbz2) tar xjf "$1" ;;
		*.tar.xz|*.txz)   tar xJf "$1" ;;
		*.tar.zst)        tar --zstd -xf "$1" ;;
		*.tar)            tar xf "$1" ;;
		*.zip)            unzip "$1" ;;
		*.gz)             gunzip "$1" ;;
		*.bz2)            bunzip2 "$1" ;;
		*.xz)             unxz "$1" ;;
		*.7z)             7z x "$1" ;;
		*.rar)            unrar x "$1" ;;
		*) echo "Unsupported format: $1"; return 1 ;;
	esac
}

# cheat: terminal keybinding cheatsheet, plus this machine's own notes if present
# (~/.config/ghostty/CHEATSHEET.local.md, kept out of the repo)
cheat() {
	local -a files=(~/.config/ghostty/CHEATSHEET.md)
	[ -f ~/.config/ghostty/CHEATSHEET.local.md ] && files+=(~/.config/ghostty/CHEATSHEET.local.md)
	if command -v glow >/dev/null; then
		command cat "${files[@]}" | glow -p -
	else
		bat --style=plain --language=md "${files[@]}" 2>/dev/null || command cat "${files[@]}"
	fi
}
